rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.uid in [
        'UmLTmvEvtIcrjK3SEaK6WvXmUDf2',
        'iNrdOx7MLbNc7XYhema3drFLjYq1'
      ];
    }
    match /assignments/{assignmentId} {
      allow read, delete: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['title','subject','due','notes','status','earnedStars','createdAt','turnedInAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 60
        && request.resource.data.due is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.status in ['todo','finished','turned_in']
        && request.resource.data.earnedStars in [0,10];
    }
  }
}
